# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0

name                shaderc
set theVersion      2026.4.21
subport glslang     {}
subport spirv-tools {}

if {${subport} ne "${name}"} {
    PortGroup       stub 1.0
    version         ${theVersion}
    epoch           1
    if {${subport} eq "glslang"} {
        description OpenGL and OpenGL ES reference compiler for shading languages
    } elseif {${subport} eq "spirv-tools"} {
        description SPIR-V assembler, binary module parser, \
                    disassembler, validator, and optimiser
    }
    long_description \
                    {*}${description}. Provided by port:${name}.

    depends_run     port:shaderc
    return
}

PortGroup           github 1.0
PortGroup           cmake 1.1
PortGroup           legacysupport 1.1

set LTO.fat_LTO_Objects yes
PortGroup           LTO 1.0
PortGroup           python-required 1.0

github.setup        google shaderc 4f0683ab2419ecbb9e18c9edfd4ffd70c2ba8cc6
version             ${theVersion}
fetch.type          git
distname            ${name}-git

post-extract {
    ui_msg "--->    Fetching additional dependencies"
    system -W ${worksrcpath} "utils/git-sync-deps"
}

categories          graphics devel
license             Apache-2
maintainers         openmaintainer

description         A collection of tools, libraries, and tests for Vulkan shader compilation.
long_description    Shaderc provides a collection of tools, libraries and tests for shader \
                    compilation. At the moment it includes: glslc, a command line compiler for \
                    GLSL/HLSL to SPIR-V, and libshaderc, a library API for accessing glslc \
                    functionality.\n\
                    Building this port requires the sources for, builds and installs glslang plus \
                    spirv-tools, so this version of port:${name} replaces the individual ports \
                    for those tools with stubs (instead of conflicting with them).

find_new_enough_python3 6

# conflicts           glslang \
#                     spirv-tools

compiler.cxx_standard 2017
compiler.blacklist  {clang < 1100} {macports-clang-[0-9].*} {macports-clang-10}

platform darwin {
    # Need to use MacPorts libc++ on macOS 10.14 Mojave and older, because
    # Apple Clang only added support for the C++17 <filesystem> library
    # starting in Xcode 11 (clang-1100) for macOS 10.15+.
    # 
    # References:
    # * https://stackoverflow.com/a/55353263
    # * https://developer.apple.com/documentation/xcode-release-notes/xcode-11-release-notes
    legacysupport.newest_darwin_requires_legacy 18
    legacysupport.use_mp_libcxx yes
}

variant docs description {install the documentation} {}
if {![variant_isset docs]} {
    patchfiles-append   patch-no-documentation.diff
} else {
    depends_build-append \
                        port:asciidoctor
}

depends_build-append    port:python${py_ver_nodot} \
                        path:bin/pkg-config:pkgconfig

configure.python        ${prefix}/bin/python${py_ver}

configure.args-append   -DPython_EXECUTABLE:FILEPATH=${configure.python} \
                        -DPython3_EXECUTABLE:FILEPATH=${configure.python} \
                        -DSHADERC_SKIP_TESTS=ON \
                        -DSHADERC_SKIP_EXAMPLES=ON \
                        -DSHADERC_SKIP_COPYRIGHT_CHECK=ON
if {[string match macports-gcc* ${configure.compiler}] && [string match *libc++ ${configure.cxx_stdlib}]} {
    # G++ raises a false alarm about a member value being used non-initialised in a libc++ headerfile
    configure.args-append \
                        -DSHADERC_ENABLE_WERROR_COMPILE=OFF
}

build.post_args         -wk
