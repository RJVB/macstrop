# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           muniversal 1.0
if {[variant_exists static] && [variant_isset static]} {
    set LTO.fat_LTO_Objects yes
}
set LTO.allow_ThinLTO no
PortGroup           LTO 1.0

name                libjpeg-turbo
conflicts           mozjpeg
#set my_name         libjpeg-turbo
version             3.2.0
set branch          [join [lrange [split ${version} .] 0 1] .]
github.setup        ${name} ${name} ${version}
github.tarball_from releases

categories          graphics
platforms           darwin linux
license             BSD
maintainers         {larryv @larryv} {mascguy @mascguy} {jmr @jmroot}

description         SIMD-accelerated libjpeg-compatible JPEG codec \
                    library
long_description    libjpeg-turbo is a JPEG image codec that uses SIMD \
                    instructions (MMX, SSE2, NEON) to accelerate \
                    baseline JPEG compression and decompression on \
                    x86, x86-64, and ARM systems. On such systems, \
                    libjpeg-turbo is generally 2-6x as fast as \
                    libjpeg, all else being equal. On other types of \
                    systems, libjpeg-turbo can still outperform \
                    libjpeg by a significant amount, by virtue of its \
                    highly-optimised Huffman coding routines. In many \
                    cases, the performance of libjpeg-turbo rivals \
                    that of proprietary high-speed JPEG codecs.
homepage            https://www.${name}.org

dist_subdir         ${name}

checksums           rmd160 b94eebc6c6af8c3d367a1ce92c8f68e09741c3cb \
                    sha256 6f30092cef9fb839779646608f4ee14ae3cbac989c47fa05e841b0841f09878e

patch.pre_args      -Np1
# # on darwin, create an additional copy of libjpeg with the compatibility_version set to 10.0.0
# # for the sake of the likely numerous dependents built against an earlier libjpeg-turbo version
# # that declared that version but is otherwise perfectly compatible.
# patchfiles-append   patch-compatver10.diff
platform darwin {
    variant preserve_compatibility description {make the generated library runtime compatible for existing dependents} {
        patchfiles-append \
                    patch-setcompatver=10.diff
    }
    if {[file exists ${prefix}/lib/libjpeg.10.dylib]} {
        default_variants-append \
                    +preserve_compatibility
    }
# for patch-compatver10.diff ...
#     depends_build-append \
#                     port:cctools
}


configure.args-append \
                    -DENABLE_SHARED=ON \
                    -DENABLE_STATIC=OFF \
                    -DWITH_JPEG8=ON \
                    -DWITH_SYSTEM_ZLIB=OFF

if {${universal_possible} && [variant_isset universal]} {
    if {"x86_64" in ${configure.universal_archs} || "i386" in ${configure.universal_archs}} {
        depends_build-append port:nasm
    }
    set merger_configure_env(i386)  ASM_NASM=${prefix}/bin/nasm
    set merger_configure_env(x86_64)    ASM_NASM=${prefix}/bin/nasm
} elseif {${configure.build_arch} in {i386 x86_64}} {
    depends_build-append port:nasm
    configure.env       ASM_NASM=${prefix}/bin/nasm
} elseif {${configure.build_arch} eq "ppc"} {
    if {[catch {sysctl hw.vectorunit} result] || $result == 0} {
        configure.args-append   -DWITH_SIMD=OFF
        archive_sites
    }
}

post-destroot {
    # for a while, builds with the JPEG8 ABI still used 10 for their SOVERSION
    if {${os.platform} eq "darwin"} {
#         # create libjpeg.10.dylib from our custom libjpegcv
#         file rename ${destroot}${prefix}/lib/libjpegcv.8.${branch}.dylib ${destroot}${prefix}/lib/libjpeg.10.dylib
#         system "install_name_tool -id ${prefix}/lib/libjpeg.10.dylib ${destroot}${prefix}/lib/libjpeg.10.dylib"
#         file delete -force ${destroot}${prefix}/lib/libjpegcv.dylib ${destroot}${prefix}/lib/libjpegcv.8.dylib
        if {[variant_isset preserve_compatibility]} {
            ln -s libjpeg.8.dylib ${destroot}${prefix}/lib/libjpeg.10.dylib
        }
    } else {
        ln -s libjpeg.so.8 ${destroot}${prefix}/lib/libjpeg.so.10
    }
}

variant static description {also install the static library} {
    configure.args-replace \
                    -DENABLE_STATIC=OFF \
                    -DENABLE_STATIC=ON
}

variant mpzlib description {use port:zlib (may cause tests to fail)} {
    depends_lib-append  port:zlib
    configure.args-replace \
                        -DWITH_SYSTEM_ZLIB=OFF \
                        -DWITH_SYSTEM_ZLIB=ON
}

variant java description {Add Java support} {
    PortGroup           java 1.0

    java.version        1.8
    java.fallback       openjdk8
    configure.args-append \
                        -DWITH_JAVA=ON
}

# variant tests description {Enable tests} {
#     configure.pre_args-replace \
#                         -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=ON \
#                         -DCMAKE_BUILD_WITH_INSTALL_RPATH:BOOL=OFF

    test.run            yes
    test.env-append     DYLD_LIBRARY_PATH=${destroot}${prefix}/lib \
                        LD_LIBRARY_PATH=${destroot}${prefix}/lib \
                        CTEST_OUTPUT_ON_FAILURE=1
# }

# Betas are numbered x.x.9x
github.livecheck.regex  {(\d+\.\d+\.(?:\d|[0-8]\d)(?:\.[0-9]+)*)}
