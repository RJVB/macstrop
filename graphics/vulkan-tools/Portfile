PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1
set LTO.allow_ThinLTO   no
PortGroup           LTO 1.0
PortGroup           python-required 1.0

github.setup        KhronosGroup Vulkan-Tools 1.4.363 v
github.tarball_from archive
name                vulkan-tools

categories          graphics
platforms           darwin linux
license             Apache-2
maintainers         {judaew @judaew} openmaintainer

description         Vulkan tools
long_description    Provides vulkaninfo command for checking Vulkan installation configuration status
homepage            https://vulkan.lunarg.com

depends_build-append \
                    port:vulkan-headers \
                    port:vulkan-volk \
                    path:bin/glslc:shaderc

depends_lib-append  port:vulkan-loader

if {${os.platform} eq "darwin"} {
    if {${os.major} < 15} {
        archive_sites
        distfiles
        depends_build
        known_fail  yes
	    long_description-append \n\
            Only supported on Mac OS \"Sierra\" and up!
        pre-fetch {
            ui_error "${subport} @${version} requires macOS Sierra or later"
            return -code error "incompatible OS X version"
        }
	   return
    }
}

checksums           sha256  a41172b681c2b9d40e154b0e3acd56b10e12eb910c4dbe60a1d90db0b73e01b2 \
                    rmd160  68d2d7d9884d3f5ee2bdccf168915b6a08047f0f
#                     size    821754

find_new_enough_python3 9

foreach stage {configure build destroot test} {
    ${stage}.env-append PATH=${frameworks_dir}/Python.framework/Versions/${py_ver}/bin:$env(PATH)
}
depends_build-append port:python${py_ver_nodot}

if {${os.platform} eq "darwin"} {
    # TODO: cube, icd
    configure.args-append \
                    -DBUILD_CUBE=OFF
} else {
    configure.args-append \
                    -DBUILD_CUBE=ON
}
configure.args-append \
                    -DBUILD_ICD=OFF \
                    -DDTOOLS_VULKANINFO=ON \
                    -DDTOOLS_CODEGEN=ON \
                    -DVULKAN_LOADER_INSTALL_DIR=${prefix}
# ?!                    -DVULKAN_LOADER_INSTALL_DIR=${prefix}/lib

cmake.save_configure_cmd "install log"
