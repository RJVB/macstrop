# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           LTO 1.0
PortGroup           save_configure_cmd 1.0

# update along with mediainfolib
github.setup        MediaArea MediaInfo 26.05 v
github.tarball_from archive
name                mediainfo
categories          multimedia
license             BSD
maintainers         {makr @mohd-akram} openmaintainer

description         technical and tag data for video and audio files

long_description    MediaInfo is a convenient unified display of the most \
                    relevant technical and tag data for video and audio files.

platforms           darwin linux
homepage            https://mediaarea.net/en/MediaInfo

checksums           rmd160  08159f31a87a71a2ff789a39a3909859f315682b \
                    sha256  90dd67f5a70bb87158d7024456339f5062f59776188427d7158d07a43e6a46d1
#                    size    18038139

installs_libs       no

depends_extract-append \
                    port:dos2unix

post-extract {
    # force consistent line-endings
    system -W ${worksrcpath} "find . \\\( -name \"*.cpp\" -o -name \"*.h\" \\\) -exec dos2unix '{}' \";\""
}

depends_build       path:bin/pkg-config:pkgconfig

depends_lib         port:mediainfolib \
                    port:zenlib \
                    port:zlib

if {${name} eq ${subport}} {
    worksrcdir      ${worksrcdir}/Project/GNU/CLI
}

compiler.cxx_standard   2011

subport mediainfo-gui {
    variant qt5 description {Use the Qt5 GUI} {}

    if {[variant_isset qt5]} {
        PortGroup       qmake5 1.0

        configure.dir   ${worksrcpath}/Project/QMake/GUI
        build.dir       ${worksrcpath}/Project/QMake/GUI

        patchfiles-append \
                        patch-qt-install-in-prefix.diff \
                        patch-support-older-qt5.diff

        qt5.depends_component \
                        qtdeclarative \
                        qtwebengine

        # install resources ignored by the QMake/.pro file:
        post-destroot {
            platform darwin {
                xinstall -d -m 755 ${destroot}${qt_apps_dir}
                system -W ${configure.dir} \
                        "ditto --rsrc MediaInfo.app ${destroot}${qt_apps_dir}/MediaInfo.app"
                qt5.add_app_wrapper mediainfo-gui MediaInfo
            }
            xinstall -d -m 755 ${destroot}${prefix}/share/apps/konqueror/servicemenus
            xinstall -m 644 ${worksrcpath}/Project/GNU/GUI/mediainfo-gui.kde3.desktop \
                           ${destroot}${prefix}/share/apps/konqueror/servicemenus/mediainfo-gui.desktop
            xinstall -d -m 755 ${destroot}${prefix}/share/kde4/services/ServiceMenus
            xinstall -m 644 ${worksrcpath}/Project/GNU/GUI/mediainfo-gui.kde4.desktop \
                           ${destroot}${prefix}/share/kde4/services/ServiceMenus/mediainfo-gui.desktop
            xinstall -d -m 755 ${destroot}${prefix}/share/kservices5/ServiceMenus
            xinstall -m 644 ${worksrcpath}/Project/GNU/GUI/mediainfo-gui.kde4.desktop \
                           ${destroot}${prefix}/share/kservices5/ServiceMenus/mediainfo-gui.desktop
            xinstall -d -m 755 ${destroot}${prefix}/share/icons/hicolor/256x256/apps
            xinstall -m 644 ${worksrcpath}/Source/Resource/Image/MediaInfo.png \
                           ${destroot}${prefix}/share/icons/hicolor/256x256/apps/mediainfo.png
            xinstall -d -m 755 ${destroot}${prefix}/share/icons/hicolor/scalable/apps
            xinstall -m 644 ${worksrcpath}/Source/Resource/Image/MediaInfo.svg \
                           ${destroot}${prefix}/share/icons/hicolor/scalable/apps/mediainfo.svg
            xinstall -d -m 755 ${destroot}${prefix}/share/pixmaps
            xinstall -m 644 ${worksrcpath}/Source/Resource/Image/MediaInfo.xpm \
                           ${destroot}${prefix}/share/pixmaps/mediainfo.xpm
        }
    } else {
        PortGroup       app 1.0
        PortGroup       wxWidgets 1.0

        if {${os.platform} eq "darwin" && ${os.major} >= 13} {
            wxWidgets.use wxWidgets-3.2
        } elseif {${os.platform} eq "darwin" && ${os.major} > 11} {
            wxWidgets.use wxWidgets-3.0-cxx11
        } else {
            #wxWidgets.use wxGTK-3.0-cxx11
            wxWidgets.use wxWidgets-3.2
        }

        depends_lib-append \
                        port:${wxWidgets.port}

        autoreconf.dir  ${worksrcpath}/Project/GNU/GUI
        configure.dir   ${worksrcpath}/Project/GNU/GUI
        build.dir       ${worksrcpath}/Project/GNU/GUI

        post-patch {
            reinplace "s|__WXMAC__|__WXMAC__POINTLESS|g" ${worksrcpath}/Source/GUI/WxWidgets/App.cpp
        }

        configure.args  --with-wxdir=${wxWidgets.wxdir} \
                        --with-wx-gui

        app.executable  mediainfo-gui
        app.name        MediaInfo
        app.icon        ../../../Source/GUI/Cocoa/mediainfo.icns
    }
}

if {![variant_exists qt5] || ![variant_isset qt5]} {
    use_autoreconf  yes
}

if {[file exists ${configure.dir}/config.log]} {
    use_autoreconf  no
}

build.post_args-append \
                    -wk
