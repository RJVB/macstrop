# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           cmake 1.1
PortGroup           github 1.0

name                fluidsynth

subport signalsmith_basics {}
if {${subport} eq "signalsmith_basics"} {
    description     A collection of basic audio effects
    long_description \
                    A collection of basic effects, available as plugins and re-usable \
                    open-source C++ classes (i.e. source code to be used in other projects). \
                    Currently provided are: \
                    Analyser Chorus Crunch Dynamics (compressor/expander/gate) Frequency Shifter Limiter Reverb
    license         MIT
    installs_libs   no
    supported_archs noarch

    # as of 20261028, HEAD=369e906e03760ec219d07b06fa06dc4fd099f377=tag 1.2.1
    github.setup    Signalsmith-Audio basics 1.2.1
    github.tarball_from archive
    # currently there are no submodules, so we can fetch a tarball.
    checksums       rmd160  c1386835acd5514306825073059db4992f4208ed \
                    sha256  a5a7dfcfce479c1520a8170fcfdab0cadb6ec017bcaea33203022c6ce6e3385c
#                     size    22350

    depends_build
    use_configure   no
    build           {}

    destroot {
        xinstall -d ${destroot}${prefix}/src/
        file copy ${worksrcpath} ${destroot}${prefix}/src/signalsmith-audio-basics
    }

    # subport done, we can return here and leave the rest of the file to the main port.
    return
}

PortGroup           preserve_runtime_libraries 1.0
PortGroup           LTO 1.0

github.setup        FluidSynth fluidsynth 2.6.0 v ; revision 1
# Change github.tarball_from to 'releases' or 'archive' next update
github.tarball_from archive
categories          multimedia audio
maintainers         gmail.com:rjvbertin openmaintainer
license             LGPL

description         FluidSynth is a real-time software synthesizer based on the SoundFont 2 specifications.
long_description    FluidSynth is a cross-platform real-time software synthesizer with \
                    support for SoundFont 2 and a built-in command line shell. \
                    It may be used for playback of MIDI files, but also \
                    provides a shared library which can be used in other programs.

platforms           darwin linux

homepage            http://www.fluidsynth.org/

checksums           rmd160  c0de2f9625b66e86bfb1e7c7b8880d00ce378b41 \
                    sha256  6d17570ea2086dd6fbcac995465773a6f316e689089b7fb7ba0b34c2ec6f680d
#                     size    2270011

## v2.6.0 downloads a copy of "GCEM" during the configure step; this might
## make an interesting port on itself.
depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    port:signalsmith_basics

depends_lib         port:flac \
                    port:gettext \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    port:libiconv \
                    port:libogg \
                    port:libsndfile \
                    port:libvorbis \
                    port:ncurses \
                    port:portaudio \
                    port:readline

depends_run-append  port:generaluser-soundfont

post-extract {
    file delete -force ${worksrcpath}/signalsmith-audio-basics
    ln -s ${prefix}/src/signalsmith-audio-basics ${worksrcpath}/signalsmith-audio-basics
}

# https://trac.macports.org/ticket/68458
compiler.cxx_standard   2017

if {${configure.build_arch} eq "arm64"} {
    # parallel build fails on some arm platforms
    # make[2]: *** read jobs pipe: Resource temporarily unavailable.  Stop.
    use_parallel_build no
}

# https://trac.macports.org/ticket/36962
platform darwin 8 {
    patchfiles-append \
                    patch-tiger.diff
}

# respect MacPorts compiler for builing make_tables.exe
# see https://trac.macports.org/wiki/UsingTheRightCompiler
# patchfiles-append   patch-external_project_cc.diff

# headerfile os/log.h is not required and breaks the build on older OS X versions
patchfiles-append   patch-fluid_coremidi.c-log.diff

if {${os.platform} eq "darwin"} {
    depends_build-append \
                    port:gmake
    build.cmd       gmake
    configure.args-append \
                    -Denable-pulseaudio=OFF \
                    -Denable-pipewire=OFF \
                    -Denable-portaudio=OFF
} else {
    depends_lib-append \
                    port:alsa-lib \
                    port:pulseaudio \
                    port:portaudio
    default_variants-append +dbus
    configure.args-append \
                    -Denable-pulseaudio=ON \
                    -Denable-pipewire=OFF \
                    -Denable-portaudio=ON
    variant pipewire description {use PipeWire instead of PulseAudio} {
        depends_lib-replace \
                    port:pulseaudio \
                    port:pipewire
        configure.args-replace \
                    -Denable-pulseaudio=ON \
                    -Denable-pulseaudio=OFF \
                    -Denable-pipewire=OFF \
                    -Denable-pipewire=ON
    }
    configure.ldflags-append \
                    -pthread
}

configure.args-append \
                    -Denable-jack=OFF \
                    -Denable-dbus=OFF \
                    -Denable-framework=OFF \
                    -Denable-ipv6=ON \
                    -Denable-sdl3=OFF \
                    -Denable-native-dls=ON \
                    -DLIB_SUFFIX="" \
                    -DCMAKE_DISABLE_FIND_PACKAGE_Doxygen=ON \
                    -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=ON \
                    -DDEFAULT_SOUNDFONT=${prefix}/share/sounds/sf2/GeneralUser_GS_v1.471.sf2

# support for JACK makes JACK output the default and requires the daemon to be running
variant jack description {Enable JACK support (requires the deamon to be running)} {}
if {[variant_isset jack]} {
    depends_lib-append \
                    port:jack
    configure.args-replace \
                    -Denable-jack=OFF -Denable-jack=ON
}

variant dbus description {Enable D-Bus support} {}
if {[variant_isset dbus]} {
    depends_lib-append \
                    port:dbus
    configure.args-replace \
                    -Denable-dbus=OFF -Denable-dbus=ON
}

variant openmp description {Enable OpenMP support} {}
if {[variant_isset openmp]} {
    compiler.openmp_version 4.0
    depends_lib-append      port:libomp
    configure.args-replace  -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=ON \
                            -DCMAKE_DISABLE_FIND_PACKAGE_OpenMP=OFF
    if {[string match *clang* ${configure.compiler}]} {
        configure.cflags-append -fopenmp-version=40
    }
}
default_variants-append +openmp

post-destroot {
    preserve_libraries ${prefix}/lib "libfluidsynth.*.dylib libfluidsynth.so.*"
}

test.run            yes
test.target         check
