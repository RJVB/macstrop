# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           cmake 1.1
PortGroup           LTO 1.0

epoch               1
github.setup        PortMidi portmidi 6b51c25659965ff763e266e4d90be099b5bcb344
version             2.0.8.2
github.tarball_from archive
fetch.type          git
distname            ${name}-git

categories          audio devel
platforms           darwin linux
maintainers         nomaintainer
license             MIT

description         Free, cross platform, open-source, real-time MIDI I/O library.
long_description    ${description}

# checksums           rmd160  d6aef7129a48ebee20983b58cd78a59acfd71aad \
#                     sha256  f21201d4cc233638d7bb6ee29ee6dece54f6c9c1aeb7989bc978001caaf2f666 \
#                     size    190833
# 

if {${os.platform} eq "linux"} {
    depends_lib-append \
                    port:alsa-lib
} elseif {${os.platform} ne "darwin"} {
    depends_lib-append \
                    port:libsndio
    configure.args-append \
                    -DUSE_SNDIO=ON
}
patchfiles-append   patch-CMakeLists.txt.diff

# The developer forgets to increase the version number
post-patch {
    set mamipa      [join [lrange [split ${version} .] 0 2] .]
    reinplace -q "s|2.0.7|${mamipa}|g" ${worksrcpath}/CMakeLists.txt
}

# configure.args      -DCMAKE_BUILD_WITH_INSTALL_RPATH=OFF ?!
configure.args-append \
                    -DBUILD_PORTMIDI_TESTS=ON

# pmmacosxcm.c: error: ‘for’ loop initial declaration used outside C99 mode
# Passing -std=c99 does not save though, the build then fails with numerous errors of the kind:
# readbinaryplist.c: error: ‘struct value_struct’ has no member named ‘integer’
compiler.blacklist-append *gcc-4.*

# patchfiles          patch-CMakeLists.txt.diff \
#                     patch-pm_common-CMakeLists.txt.diff \
#                     patch-pm_dylib-CMakeLists.txt.diff

# There is no way to run the full test suite automatically.
# See pm_test/README.txt. So this just runs one of the tests
# that doesn't require manual MIDI input.
test.run            yes
test.env-append     DYLD_LIBRARY_PATH=${test.dir} \
                    LD_LIBRARY_PATH=${test.dir}
test.cmd            ./qtest

post-destroot {
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 644 -W ${worksrcpath} \
        README.txt \
        license.txt \
        pm_mac/README_MAC.txt \
        pm_linux/README_LINUX.txt \
        ${docdir}
}
