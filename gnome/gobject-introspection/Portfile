# Fix library search path on non-/usr/local installs (e.g. Apple Silicon)
# See: https://github.com/Homebrew/homebrew-core/issues/75020
#      https://gitlab.gnome.org/GNOME/gobject-introspection/-/merge_requests/273
patchfiles-append   patch-library-search-path.diff

if {${os.platform} eq "darwin"} {
    depends_build-append \
                    port:cctools
    patchfiles-append \
                    patch-fix-rpath-gir-typelib.diff
    post-patch {
        reinplace "s|libcairo-gobject\\.2\\.dylib|${prefix}/lib/libcairo-gobject.2.dylib|g" ${worksrcpath}/gir/meson.build
        reinplace "s|@MP_LIB@|${prefix}/lib/|g" ${worksrcpath}/giscanner/shlibs.py
    }
    if {${subport} eq ${name}} {
        post-destroot {
            # annoyingly this appears to be necessary:
            system "install_name_tool -id ${prefix}/lib/libgirepository-1.0.1.dylib ${destroot}${prefix}/lib/libgirepository-1.0.dylib"
        }
    }
} else {
    configure.args-append \
                    --libdir=${prefix}/lib
    configure.ldflags-append \
                    -Wl,-rpath,${prefix}/lib
    post-destroot {
        if {${subport} eq "${name}"} {
            ui_msg " ---> injecting absolute paths in .gir and .typelib files"
            system -W ${destroot}${meson.install_prefix}/share/gir-1.0 \
                "patch -p0 -i ${filespath}/patch-rpath-in-gir-linux.diff"
            foreach g [glob ${destroot}${meson.install_prefix}/share/gir-1.0/*.gir] {
                reinplace -q "s|@PREFIX@|${meson.install_prefix}|g" ${g}
                # regenerate the typelib file
              set typelib "[file rootname ${g}].typelib"
                system -W ${destroot}${meson.install_prefix}/share/gir-1.0 "${build.dir}/tools/g-ir-compiler -o ${typelib} ${g} \
                    --includedir ${build.dir}/gir --includedir ${worksrcpath}/gir"
            }
            file delete {*}[glob -nocomplain ${destroot}${prefix}/share/gir-1.0/*.gir.orig]
        }
    }
    if {${subport} eq "${name}"} {
        notes-append   "Don't forget to install port:system-girepository!"
    }
}
post-patch {
    reinplace "s|@MP_LIB@|${prefix}/lib|g" ${worksrcpath}/giscanner/shlibs.py ${worksrcpath}/giscanner/ccompiler.py
    reinplace "s|@MP_PYTHON_CMD@|${configure.python}|g" ${worksrcpath}/tools/meson.build
    reinplace "s|#!/usr/bin/env python3|#!${configure.python}|g" \
        misc/update-gtkdoc-tests.py \
        misc/update-vulkan-gir.py \
        tests/gi-tester
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/giscanner/transformer.py
}

configure.python    ${prefix}/bin/python${py_ver}

configure.args-append \
                    -Ddoctool=enabled \
                    -Dpython=${configure.python} \
                    -Dextra_library_paths=${prefix}/lib

compiler.c_standard 2011

subport gobject-introspection-bootstrap {
    description             gobject-introspection bootstrap build to avoid circular dependency with glib2.
    long_description        {*}${description} \nSee \
                            https://discourse.gnome.org/t/dealing-with-glib-and-gobject-introspection-circular-dependency/18701

    depends_lib-delete      path:lib/pkgconfig/cairo.pc:cairo
    depends_lib-replace     path:lib/pkgconfig/glib-2.0.pc:glib2 \
                            port:glib2-bootstrap

    meson.install_prefix    ${prefix}/libexec/gobject-introspection-bootstrap
    if {${os.platform} ne "darwin"} {
        depends_build-append \
                            port:patchelf
        configure.args-replace \
                            --libdir=${prefix}/lib \
                            --libdir=${meson.install_prefix}/lib
        configure.ldflags-append \
                            -Wl,-rpath,${prefix}/libexec/glib2-bootstrap/lib \
                            -Wl,-rpath,${meson.install_prefix}/lib
        post-patch {
            foreach l {gio girepository glib gmodule gobject gthread} {
                reinplace "s|=${l}-2\\.0|=${l}Bootstrap-2.0|g" ${worksrcpath}/gir/meson.build
            }
        }
    }
    #configure.pre_args      setup --prefix=${prefix}/libexec/gobject-introspection-bootstrap
    configure.args-replace  -Dextra_library_paths=${prefix}/lib \
                            -Dextra_library_paths=${prefix}/lib:${prefix}/libexec/glib2-bootstrap/lib
    configure.args-append   -Dcairo=disabled \
                            -Dbuild_introspection_data=false
    configure.pkg_config_path-prepend   ${prefix}/libexec/glib2-bootstrap/lib/pkgconfig
    configure.ldflags-append \
                            -L${prefix}/libexec/glib2-bootstrap/lib

    build.env-append        PKG_CONFIG_PATH=${prefix}/libexec/glib2-bootstrap/lib/pkgconfig
    if {${os.platform} ne "darwin"} {
        build.env-append    LD_LIBRARY_PATH=${prefix}/libexec/glib2-bootstrap/lib
        destroot.env-append LD_LIBRARY_PATH=${prefix}/libexec/glib2-bootstrap/lib
    }
    destroot.env-append     PKG_CONFIG_PATH=${prefix}/libexec/glib2-bootstrap/lib/pkgconfig
}
if {${subport} eq "${name}"} {
    notes-append "You can now deactivate or desinstall port:${name}-bootstrap!"
}

# By default, gir will attempt to link programs using
# the same compiler used to build Python itself. However,
# the system clang on 10.6 does not appear to respect
# LIBRARY_PATH, resulting in g-ir-scanner errors such as:
#
# ld: library not found for -lgio-2.0
#
# The following workaround selects a more up-to-date linker
# when building this project. Identical logic already exists
# in the gobject_introspection PortGroup, so dependent projects
# should not require modification.
#
# 10.6.8 Rosetta requires a specific solution: https://github.com/mesonbuild/meson/issues/10351

build.env-append    CC=${configure.cc}

post-destroot {
    if {${subport} eq ${name}} {
        preserve_libraries ${prefix}/lib "libgirepository-1.0.*.dylib libgirepository-1.0.so.*"
        system "echo true > ${destroot}${prefix}/share/gobject-introspection-1.0/.isBootstrapped"
    } elseif {${subport} eq "gobject-introspection-bootstrap"} {
        platform linux {
            # the rpath needs fixing, or else the bootstrap binaries will pick up
            # the solibs from the installed main port (and e.g. report its version).
            set rpath "${meson.install_prefix}/lib:${prefix}/lib"
            foreach f [glob ${destroot}${meson.install_prefix}/bin/*] {
                catch { [system "patchelf --set-rpath ${rpath} ${f}"] }
            }
            foreach f [glob ${destroot}${meson.install_prefix}/lib/*.so] {
                catch { [system "patchelf --set-rpath ${rpath} ${f}"] }
            }
        }
    }
}
