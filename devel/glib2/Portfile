post-patch {
    reinplace -W ${worksrcpath} "s|@PYTHON@|${configure.python}|" \
        meson.build

    if {${os.platform} eq "darwin"} {
        reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}|g" \
            gio/xdgmime/xdgmime.c \
            glib/gi18n-lib.h \
            glib/gi18n.h \
            gio/gdbusaddress.c \
            girepository/girepository.c \
            glib/gutils.c
    } else {
        reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}/share:/usr/local|g" \
            gio/xdgmime/xdgmime.c
        reinplace -W ${worksrcpath} "s|@PREFIX@|${prefix}|g" \
            glib/gi18n-lib.h \
            glib/gi18n.h \
            girepository/girepository.c \
            glib/gutils.c
        reinplace -W ${worksrcpath} "s|@PREFIX@||g" \
            gio/gdbusprivate.c \
            gio/gdbusaddress.c
    }

    # Upstream mixes three variations of Python shebangs, so account for all
    fs-traverse f ${worksrcpath} {
        if {[string match *.py ${f}]} {
            ui_info "patching testpath: ${f}"
            reinplace -q "s|/usr/bin/python3$|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python$|${configure.python}|" ${f}
            reinplace -q "s|/usr/bin/env python3$|${configure.python}|" ${f}
        }
    }
}

if {${os.platform} ne "darwin"} {
    build.env-append LD_LIBRARY_PATH=${build.dir}/glib
}
build.args-append           --verbose
build.pre_args-append       -k 0

post-build {
    if {[variant_exists universal] && [variant_isset universal]} {
        set dirs {}
        foreach arch ${universal_archs_to_use} {
            lappend dirs ${workpath}/build-${arch}
        }
    } else {
        set dirs ${workpath}/build
    }
    foreach dir ${dirs} {
        # -lm is spuriously added by meson NYD to some builds (arm64)
        reinplace -q {s| -lm||g}              ${dir}/meson-private/glib-2.0.pc
    }
}

# test.args-append            --verbose
test.run                    yes
test.target                 --verbose test

post-destroot {
    delete ${destroot}${prefix}/lib/charset.alias

    if {${subport} ne "glib2-bootstrap"} {
        set docdir ${prefix}/share/doc/${theName}
        xinstall -d ${destroot}${docdir}
        xinstall -m 0644 -W ${worksrcpath} COPYING NEWS README.md \
            ${destroot}${docdir}
        if {![file exists ${destroot}${prefix}/include/gio-unix-2.0/gio/gdesktopappinfo.h]} {
            ui_msg "installing missing gdesktopappinfo.h file"
            xinstall -m 644 ${worksrcpath}/gio/gdesktopappinfo.h ${destroot}${prefix}/include/gio-unix-2.0/gio/gdesktopappinfo.h
        }
        platform linux {
            ui_msg " ---> injecting absolute paths in .gir and .typelib files"
            set env(LD_LIBRARY_PATH) "${destroot}${prefix}/lib"
            system "printenv"
            if {![tbool gir_bootstrapping]} {
                set incdir ${prefix}/share/gir-1.0
            } else {
                set incdir ${prefix}/libexec/gobject-introspection-bootstrap/share/gir-1.0
            }
            foreach g [glob ${destroot}${prefix}/share/gir-1.0/*.gir] {
                reinplace "s|\"libg|\"${prefix}/lib/libg|g" ${g}
                reinplace -q "s|,libg|,${prefix}/lib/libg|g" ${g}
                # regenerate the typelib file
                set typelib "[file rootname ${g}].typelib"
                system -W ${destroot}${prefix}/share/gir-1.0 \
                    "../../bin/gi-compile-repository ${g} --output ${typelib} --includedir ${incdir}"
            }
        }
    } else {
        platform linux {
#             # the rpath needs fixing, or else the bootstrap binaries will pick up
#             # the solibs from the installed main port (and e.g. report its version).
#             set rpath "${meson.install_prefix}/lib:${prefix}/lib"
#             foreach f [glob ${destroot}${meson.install_prefix}/lib/*.so] {
#                 catch { [system "patchelf --set-rpath ${rpath} ${f}"] }
#             }
#             foreach f [glob ${destroot}${meson.install_prefix}/bin/*] {
#                 catch { [system "patchelf --set-rpath ${rpath} ${f}"] }
#             }
            # the rpath needs fixing, or else the bootstrap binaries will pick up
            # the solibs from the installed main port (and e.g. report its version).
            # problem is, any dependent of us will face the same problem, including
            # during gir builds which are *(Q&$@# hard to control.
            # So, rather than fixing the rpaths, we install the libraries with suffixes
            # and modify all library requirements in our own binaries
            # plus the link info in the .pc files.
            ui_msg " ---> appending a suffix to our libraries"
            set lpath ${destroot}${meson.install_prefix}/lib
            set soversion 0.8800.1
            foreach l {gio girepository glib gmodule gobject gthread} {
                foreach f [glob ${lpath}/lib${l}-2.0.so] {
                    file delete ${f}
                    ln -s lib${l}Bootstrap-2.0.so.0  ${lpath}/lib${l}Bootstrap-2.0.so
                    file delete ${f}.0
                    ln -s lib${l}Bootstrap-2.0.so.${soversion}  ${lpath}/lib${l}Bootstrap-2.0.so.0
                    file rename ${f}.${soversion} ${lpath}/lib${l}Bootstrap-2.0.so.${soversion}
                }
                foreach f [glob ${lpath}/pkgconfig/*.pc] {
                    reinplace -q "s|l${l}|l${l}Bootstrap|g" ${f}
                }
                foreach f [glob ${destroot}${meson.install_prefix}/bin/*] {
                    catch { system "patchelf --replace-needed lib${l}-2.0.so.0 lib${l}Bootstrap-2.0.so.0 ${f}" }
                }
            }
            foreach l {gio girepository glib gmodule gobject gthread} {
                ln -s ${l}-2.0.pc ${lpath}/pkgconfig/${l}Bootstrap-2.0.pc
            }
        }
    }
}

if {${subport} ne "glib2-bootstrap"} {
    post-activate {
        if {[file exists /usr/share/glib-2.0/schemas]} {
            if {[catch {system "${prefix}/bin/glib-compile-schemas /usr/share/glib-2.0/schemas"} result]} {
                ui_warning "glib-compile-schemas failed on /usr/share/glib-2.0/schemas: ${result}"
            }
        }
        if {[catch {system "${prefix}/bin/glib-compile-schemas ${prefix}/share/glib-2.0/schemas"} result]} {
            ui_warning "glib-compile-schemas failed on ${prefix}/share/glib-2.0/schemas: ${result}"
        }
    }
    if {[file exists ${prefix}/libexec/gobject-introspection-bootstrap/lib/pkgconfig/gobject-introspection-1.0.pc]} {
        notes-append "You can now deactivate or uninstall port:glib2-bootstrap!"
    }
    if {[tbool gir_bootstrapping]} {
        notes-append "And you WILL need to install port:gobject-introspection >= 1.86.0!!"
    }
}

if {${os.platform} ne "linux"} {
    configure.args-append   -Ddtrace=disabled
}

platform darwin {
    # some tests fail to build on 10.6.8 Rosetta: https://trac.macports.org/ticket/65517
    # for version 2.88.0 there are also failures on 10.6 and x86_64:
    # ../glib-2.88.0/glib/tests/testing.c:470:39: error: use of undeclared identifier 'F_DUPFD_CLOEXEC'
    # so just disable the tests on 10.6 and below
    if {${os.major} <= 10} {
        configure.args-append   -Dtests=false
    }

    if {${os.major} == 9 && ${configure.build_arch} in [list ppc64 x86_64]} {
        # https://trac.macports.org/ticket/67307
        configure.cflags-append -D__DARWIN_NON_CANCELABLE=1
    }
}

variant quartz conflicts x11 {
    configure.args-append   -Dappinfo_backend=native
}

variant x11 conflicts quartz {
    if {${os.platform} eq "darwin"} {
        configure.args-append   -Dappinfo_backend=generic
    } else {
        configure.args-append   -Dappinfo_backend=native
    }
}

if {${os.platform} ne "darwin" || ![variant_isset quartz]} {
    default_variants +x11
}
if {![variant_isset x11]} {
    default_variants +quartz
}
if {![variant_isset quartz] && ![variant_isset x11]} {
    pre-configure {
        return -code error "Either +x11 or +quartz is required"
    }
}

variant docs description {Install the gtk-doc documentation for glib2} {}
if {![variant_isset docs]} {
    post-destroot {
        file delete -force ${destroot}${prefix}/share/gtk-doc
    }
} else {
    configure.args-replace  -Dgtk_doc=false \
                            -Dgtk_doc=true
}

subport glib2-bootstrap {
    description             Glib2 build with introspection disabled, used to build gobject-introspection \
                            and avoid circular dependency.
    long_description        {*}${description} \nSee \
                            https://discourse.gnome.org/t/dealing-with-glib-and-gobject-introspection-circular-dependency/18701

    depends_build-delete    port:gobject-introspection-bootstrap \
                            path:lib/pkgconfig/gobject-introspection-1.0.pc:gobject-introspection

    meson.install_prefix    ${prefix}/libexec/glib2-bootstrap
    if {${os.platform} ne "darwin"} {
        depends_build-append \
                            port:patchelf
        configure.ldflags-append \
                            -Wl,-rpath,${meson.install_prefix}/lib
    }
    #configure.pre_args      setup --prefix=${prefix}/libexec/glib2-bootstrap
    configure.args-append   -Ddocumentation=false -Dman-pages=disabled -Dnls=disabled
    configure.args-replace  -Dintrospection=enabled -Dintrospection=disabled
}

variant install_tests description {Install the built test binaries} {}
if {[variant_isset install_tests]} {
    configure.args-append  -Dinstalled_tests=true
} else {
    configure.args-append  -Dinstalled_tests=false
}

livecheck.type              gnome
livecheck.name              ${theName}

if {${subport} eq "glib2"} {
    pre-activate {
        # the new glib2 port now installs files that were previously in gobject-introspection({,-devel} ports
        if {![catch {lindex [registry_active gobject-introspection] 0} installed]} {
            set _version [lindex $installed 1]
            if {[vercmp $_version 1.86.0] < 0} {
                ui_warn "Deactivating port:gobject-introspection"
                registry_deactivate_composite gobject-introspection "" [list ports_nodepcheck 1]
            }
        }

        if {![catch {lindex [registry_active gobject-introspection-devel] 0} installed]} {
            set _version [lindex $installed 1]
            if {[vercmp $_version 1.86.0] < 0} {
                ui_warn "Deactivating port:gobject-introspection-devel"
                registry_deactivate_composite gobject-introspection-devel "" [list ports_nodepcheck 1]
            }
        }
    }
}
