# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem 1.0
PortGroup       meson 1.0
PortGroup       github 1.0
PortGroup       LTO 1.0

categories      devel drivers
description     PC/SC implementation
long_description \
                Middleware to access a smart card using SCard API (PC/SC).
homepage        https://pcsclite.apdu.fr/

github.setup    LudovicRousseau PCSC a483319d3ac27194dbbd2328dfbd51a737fa4243
name            libpcslite
version         2.5.4.1
fetch.type      git
distname        ${name}-git

license         Permissive GPL3
platforms       darwin linux

depends_build-append \
                port:flex \
                port:doxygen

depends_lib-append \
                port:policykit \
                port:zlib
if {${os.platform} eq "darwin"} {
    depends_lib-append \
                port:libusb 
    configure.args-append \
                -Dlibusb=true \
                -Dipcdir=${prefix}/run/pcscd \
} else {
    depends_lib-append \
                port:systemd
    configure.args-append \
                -Dlibudev=true
}

configure.args-append \
                -Dusb=true \
                -Dusbdropdir=${prefix}/lib/pcsc/drivers \
                -Dpolkit=true

build.pre_args-prepend \
                -k 0

post-destroot {
    reinplace "s|/usr/lib|${prefix}/lib|g" ${destroot}${prefix}/etc/default/pcscd
}

livecheck.type none
