# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem      1.0
PortGroup       gitsrc 1.1
PortGroup       legacysupport 1.1
PortGroup       LTO 1.0
PortGroup       save_configure_cmd 1.0

# clock_gettime
legacysupport.newest_darwin_requires_legacy 15

name            libusb
categories      devel
platforms       darwin linux
license         LGPL-2.1+

subport libgusb {}
if {${subport} eq "libgusb"} {
    PortGroup   meson 1.0
    PortGroup   gobject_introspection 1.0

    description GUsb is a GObject wrapper for libusb
    long_description \
                GUsb is a GObject wrapper for libusb1 that makes it easy to do asynchronous control, \
                bulk and interrupt transfers with proper cancellation and integration into a mainloop. \
                This makes it easy to integrate low level USB transfers with your high-level \
                application or system daemon.
    gitsrc.setup \
                hughsie libgusb c4c1b259070290e63b3629e9396832c6a4a94084
    gitsrc.tarball_from archive
    version     0.4.9.3

    checksums       rmd160  427a8dbd32397f6f329366e95841ec81600ad032 \
                    sha256  eada26a70302619680e15aab41d1a0786bc209f1578746dd5acd601b261ade51
#                     size    63149

    maintainers openmaintainer

    depends_build-append \
                port:hwdata \
                port:vala
    depends_lib-append \
                port:glib2 \
                port:json-glib \
                path:lib/pkgconfig/libusb-1.0.pc:libusb

    gobject_introspection yes

    # NB: Python is needed for the build, but the one used to run meson will be used.
    configure.args-append \
                -Ddocs=false \
                -Dusb_ids=${prefix}/share/hwdata/usb.ids

    test.run    yes

    return
}

description     library for USB device access
long_description \
    library for use by user level applications to \
    access USB devices regardless of OS
homepage        https://libusb.info/

maintainers     {michaelld @michaelld} openmaintainer

use_parallel_build no

# compiler with C11 support is required to build
# libusb as of version 1.0.24
compiler.c_standard 2011
# fatal error: 'stdatomic.h' file not found
compiler.blacklist-append {clang < 700}

subport libusb-devel {}

if {${subport} eq ${name}} {

    gitsrc.setup    libusb libusb 1.0.30 v
    gitsrc.tarball_from releases
    use_bzip2       yes
    checksums       rmd160  339eb74659b5907df54c5bca3199669dfbffb868 \
                    sha256  fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
#                     size    656112

    conflicts       libusb-devel

    platform darwin {
        patchfiles-append \
                patch-blacklist-behringerUMC204HD.diff
    }

    # overload the gitsrc livecheck regex to look for versions that
    # are just numbers and '.', no letters (e.g., "1.0.19rc1").

    gitsrc.livecheck.regex  {([0-9.]+)}

} else {

    # IOKit/USB.h - fixes GCC 4.5+ issue pre-Catalina
    # https://trac.macports.org/ticket/61868
    # (As of 2021-11-07 the fix requires legacy-support-devel - bump
    # this logic to the top once it is included in mainline legacy-support)
    legacysupport.newest_darwin_requires_legacy 18

    long_description {*}${long_description} \
        This port provides the devel version of ${name}.

    gitsrc.setup    libusb libusb e29f590a8fd73543fea1974cda22cbfcce22c094
    fetch.type      git
    distname        ${name}-git
    # after `git tag -d v1.0.30.rc1` :
    version         1.0.29.65

    conflicts       libusb

    # because I messed up a version as "202105416-35e8ee98_0", which
    # because of the messed up date is always greater than a correctly
    # formatted date, which means livecheck will never show a newer version.
    epoch           1

    patch.pre_args  -Np1
    patchfiles-append \
                    patch-PR1658-with-blacklisted-UMC204HD.diff

    if {![file exists ${worksrcpath}/configure] || ![file exists ${worksrcpath}/config.log]} {
        configure.cmd ./autogen.sh
    }

}

depends_build-append \
                 port:libtool \
                 port:pkgconfig \
                 port:automake \
                 port:autoconf

# https://trac.macports.org/ticket/64602
configure.checks.implicit_function_declaration.whitelist-append strchr

build.args-append AM_DEFAULT_VERBOSITY=1

configure.args-append \
                --enable-examples-build \
                --enable-tests-build

configure.save_configure_cmd "install log"

test.run        yes
test.target     check
