# -*- coding: utf-8; mode: tcl; c-basic-offset: 4; indent-tabs-mode: nil; tab-width: 4; truncate-lines: t -*- vim:fenc=utf-8:et:sw=4:ts=4:sts=4

PortSystem      1.0
PortGroup       cmake 1.1
PortGroup       github 1.0
PortGroup       legacysupport 1.0
set LTO.allow_ThinLTO no
PortGroup       LTO 1.0

github.setup    swiftlang swift-llbuild 54a6aca58deb943cc443650482545c58687f5378
    name        llbuild
    version     26.9.21.4
    distname    ${name}-git
    fetch.type  git

categories      devel
platforms       darwin linux
license         Apache-2
maintainers     gmail.com:rjvbertin openmaintainer
description     A low-level build system
long_description \
                This port provides swift-build-tool, the llbuild library/framework \
                and the `llbuild` utility that provides a command line interface \
                to various features of that library. It can also act as a drop-in \
                alternative to `ninja` (and `samu` from port:samurai).

patch.pre_args  -Np1
patchfiles-append \
                patch-for-older-osx.diff \
                patch-install-llbuild.diff

compiler.blacklist-append \
                *gcc*
foreach v {8.0 9.0 10 11 12 13 14 15 16 17} {
    compiler.fallback-prepend \
                macports-clang-${v}
}

cmake.install_prefix \
                ${prefix}/libexec/llbuild

# for utimensat (available in 10.13+)
legacysupport.newest_darwin_requires_legacy 16

configure.cppflags-append \
                -DLLBUILD_VERSION_STRING='"${version}"'

configure.args-append \
                -DBUILD_TESTING=OFF

variant ninja description {provide the ${prefix}/bin/ninja command} {
    conflicts-append \
                ninja \
                samurai
}

post-destroot {
    ln -s llbuild ${destroot}${cmake.install_prefix}/bin/ninja
    ln -s ../libexec/llbuild/bin/llbuild ${destroot}${prefix}/bin/
    if {[variant_isset ninja]} {
        ln -s ../libexec/llbuild/bin/llbuild ${destroot}${prefix}/bin/ninja
    }
}

