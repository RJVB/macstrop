# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem              1.0
PortGroup               github 1.0
if {${os.platform} ne "darwin"} {
    PortGroup           stub 1.0
    long_description    This port is Mac OS 13+ specific and a stub everywhere else.
}

github.setup            citcon-aoyansheng xcode-libarclite 0bc2dd84ca0bc4885299b8ad98ecdd7a774bb30f
name                    libarclite
version                 1.0
categories              devel sysutil
license                 Restrictive Nomirror
maintainers             nomaintainer openmaintainer
description             Apple's libarclite libraries
platforms               darwin

checksums               rmd160  497b9522a509999c5d1f86cd8e7ac3e78a5ba7b0 \
                        sha256  c3f07929792618ba3b7545c2aecb33c9b436dbc80d89f6ec0e25ed2980b91fd9
#                         size    1191931

github.tarball_from     archive

if {${os.platform} eq "darwin" && os.major >= 22} {
    long_description    {*}${description}. This port provides a copy of Apple's libarclite*.a \
                        static libraries containing implementations of Objective C automatic \
                        reference counting (ARC) for OS versions before 10.11. They are required \
                        when building ARC-enabled ObjC code *on* those OS versions (but not always \
                        found by more recent clang versions) and also when building *for* those \
                        systems on newer OS versions (which lack the libraries altogether).
    use_configure       no

    build {}

    destroot {
        copy ${worksrcpath}/arc ${destroot}${prefix}/lib
        xinstall -m 755 -d ${destroot}${prefix}/share/doc/${name}
        copy ${worksrcpath}/README.md {*}[glob ${worksrcpath}/*.png] \
                        ${destroot}${prefix}/share/doc/${name}
    }
}

