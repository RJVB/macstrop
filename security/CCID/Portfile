# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem 1.0
PortGroup       meson 1.0
PortGroup       legacysupport 1.1
PortGroup       gitsrc 1.1
PortGroup       LTO 1.0

categories      security
description     generic USB (I)CCID PC/SC driver
long_description \
                USB CCID IFD Handler. This port provides a generic USB CCID (Chip/Smart \
                Card Interface Devices) and ICCD (Integrated Circuit(s) Card Devices) \
                driver. See the USB CCID and ICCD specifications from the USB working group.

gitsrc.provider salsa.debian.org
gitsrc.setup    rousseau CCID 07a1a6567d3736923499ed5034918aff9bcfaa83
version         1.8.4.15
fetch.type      git
distname        ${name}-git

license         LGPL-2.1
platforms       darwin linux

depends_build-append \
                path:bin/pkg-config:pkgconfig \
                port:flex \
                port:perl5

depends_lib-append \
                port:libpcslite \
                port:libusb \
                port:zlib
if {${os.platform} eq "linux"} {
    depends_lib-append \
                port:systemd
} else {
    configure.args-append \
                -Dudev-rules=false
}

# counterintuitive: the pcsclite option is only about using the debug support from libpcsclite...
configure.args-append \
                -Dpcsclite=false \
                -Denable-extras=false

variant extras description {compile examples and contrib} {
    configure.args-replace \
                -Denable-extras=false \
                -Denable-extras=true
    post-destroot {
        foreach b {RSA_SecurID_getpasswd Kobil_mIDentity_switch scardcontrol} {
            xinstall -m 755 ${build.dir}/${b} ${destroot}${prefix}/bin
        }
    }
}

build.pre_args-prepend \
                -k 0

livecheck.type none
